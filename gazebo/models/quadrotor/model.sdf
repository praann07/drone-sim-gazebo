<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="quadrotor">
    <pose>0 0 0.1 0 0 0</pose>
    <static>false</static>

    
    <!-- Central Chassis / LiteWing Body -->
    <link name="base_link">
      <inertial>

        <mass>1.0</mass>
        <inertia>
          <ixx>0.012</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.012</iyy>
          <iyz>0</iyz>
          <izz>0.020</izz>
        </inertia>
      </inertial>

      <!-- Center Body Visual -->
      <visual name="chassis_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.14 0.14 0.04</size>
          </box>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.18 1</ambient>
          <diffuse>0.2 0.2 0.25 1</diffuse>
          <specular>0.5 0.5 0.5 1</specular>
        </material>
      </visual>

      <!-- LiteWing Flight Controller Board Visual -->
      <visual name="litewing_board">
        <pose>0 0 0.022 0 0 0</pose>
        <geometry>
          <box>
            <size>0.06 0.06 0.005</size>
          </box>
        </geometry>
        <material>
          <ambient>0.1 0.5 0.2 1</ambient>
          <diffuse>0.1 0.7 0.3 1</diffuse>
        </material>
      </visual>

      <!-- LiPo Battery Visual Underneath -->
      <visual name="battery_visual">
        <pose>0 0 -0.025 0 0 0</pose>
        <geometry>
          <box>
            <size>0.10 0.045 0.03</size>
          </box>
        </geometry>
        <material>
          <ambient>0.7 0.6 0.1 1</ambient>
          <diffuse>0.9 0.7 0.1 1</diffuse>
        </material>
      </visual>

      <!-- Elevated GPS Mast -->
      <visual name="gps_mast">
        <pose>-0.03 0 0.07 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.004</radius>
            <length>0.10</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.3 0.3 0.3 1</ambient>
          <diffuse>0.4 0.4 0.4 1</diffuse>
        </material>
      </visual>

      <!-- GPS GNSS Antenna Puck -->
      <visual name="gps_antenna">
        <pose>-0.03 0 0.12 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.025</radius>
            <length>0.012</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.8 0.8 0.8 1</ambient>
          <diffuse>0.9 0.9 0.9 1</diffuse>
        </material>
      </visual>

      <!-- Carbon Fiber Arm 1: Front-Right (+X, -Y) -->
      <visual name="arm_fr">
        <pose>0.07 -0.07 0 0 0 -0.7854</pose>
        <geometry>
          <box>
            <size>0.14 0.015 0.012</size>
          </box>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>

      <!-- Carbon Fiber Arm 2: Front-Left (+X, +Y) -->
      <visual name="arm_fl">
        <pose>0.07 0.07 0 0 0 0.7854</pose>
        <geometry>
          <box>
            <size>0.14 0.015 0.012</size>
          </box>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>

      <!-- Carbon Fiber Arm 3: Rear-Left (-X, +Y) -->
      <visual name="arm_rl">
        <pose>-0.07 0.07 0 0 0 -0.7854</pose>
        <geometry>
          <box>
            <size>0.14 0.015 0.012</size>
          </box>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>

      <!-- Carbon Fiber Arm 4: Rear-Right (-X, -Y) -->
      <visual name="arm_rr">
        <pose>-0.07 -0.07 0 0 0 0.7854</pose>
        <geometry>
          <box>
            <size>0.14 0.015 0.012</size>
          </box>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>

      <!-- Motor Mounts -->
      <visual name="motor_fr">
        <pose>0.1414 -0.1414 0.015 0 0 0</pose>
        <geometry>
          <cylinder><radius>0.018</radius><length>0.025</length></cylinder>
        </geometry>
        <material><ambient>0.8 0.1 0.1 1</ambient><diffuse>0.9 0.2 0.2 1</diffuse></material>
      </visual>
      <visual name="motor_fl">
        <pose>0.1414 0.1414 0.015 0 0 0</pose>
        <geometry>
          <cylinder><radius>0.018</radius><length>0.025</length></cylinder>
        </geometry>
        <material><ambient>0.8 0.1 0.1 1</ambient><diffuse>0.9 0.2 0.2 1</diffuse></material>
      </visual>
      <visual name="motor_rl">
        <pose>-0.1414 0.1414 0.015 0 0 0</pose>
        <geometry>
          <cylinder><radius>0.018</radius><length>0.025</length></cylinder>
        </geometry>
        <material><ambient>0.1 0.4 0.8 1</ambient><diffuse>0.2 0.5 0.9 1</diffuse></material>
      </visual>
      <visual name="motor_rr">
        <pose>-0.1414 -0.1414 0.015 0 0 0</pose>
        <geometry>
          <cylinder><radius>0.018</radius><length>0.025</length></cylinder>
        </geometry>
        <material><ambient>0.1 0.4 0.8 1</ambient><diffuse>0.2 0.5 0.9 1</diffuse></material>
      </visual>

      <!-- Propeller Discs (Front = Red/Amber, Rear = Cyan/Blue) -->
      <visual name="prop_fr">
        <pose>0.1414 -0.1414 0.03 0 0 0</pose>
        <geometry>
          <cylinder><radius>0.08</radius><length>0.003</length></cylinder>
        </geometry>
        <material><ambient>0.9 0.3 0.1 0.7</ambient><diffuse>0.9 0.3 0.1 0.7</diffuse></material>
      </visual>
      <visual name="prop_fl">
        <pose>0.1414 0.1414 0.03 0 0 0</pose>
        <geometry>
          <cylinder><radius>0.08</radius><length>0.003</length></cylinder>
        </geometry>
        <material><ambient>0.9 0.3 0.1 0.7</ambient><diffuse>0.9 0.3 0.1 0.7</diffuse></material>
      </visual>
      <visual name="prop_rl">
        <pose>-0.1414 0.1414 0.03 0 0 0</pose>
        <geometry>
          <cylinder><radius>0.08</radius><length>0.003</length></cylinder>
        </geometry>
        <material><ambient>0.1 0.7 0.9 0.7</ambient><diffuse>0.1 0.7 0.9 0.7</diffuse></material>
      </visual>
      <visual name="prop_rr">
        <pose>-0.1414 -0.1414 0.03 0 0 0</pose>
        <geometry>
          <cylinder><radius>0.08</radius><length>0.003</length></cylinder>
        </geometry>
        <material><ambient>0.1 0.7 0.9 0.7</ambient><diffuse>0.1 0.7 0.9 0.7</diffuse></material>
      </visual>

      <!-- Main Body Collision Cylinder -->
      <collision name="chassis_collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.24</radius>
            <length>0.08</length>
          </cylinder>
        </geometry>
      </collision>
    </link>

    <!-- Zero-Latency Native In-Memory 6-DOF UDP Telemetry Plugin -->
    <plugin name="quadrotor_pose_plugin" filename="libquadrotor_pose_plugin.so"/>
  </model>
</sdf>

